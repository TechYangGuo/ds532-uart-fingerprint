# DS532指纹模块UART驱动 Makefile - Stage 2版本
# 平台: IMX6ULL / Linux 4.9.88
# Stage 2: 协议封装功能

# 内核模块对象
obj-m += ds532_driver_stage2.o

# 内核源码路径
KDIR := /home/book/Workspace/wds/sdk/imx6ull/100ask_imx6ull-sdk/Linux-4.9.88

# 交叉编译工具链
CROSS_COMPILE := /home/book/Workspace/wds/sdk/imx6ull/100ask_imx6ull-sdk/Buildroot_2020.02.x/output/host/bin/arm-buildroot-linux-gnueabihf-
CC := /home/book/Workspace/wds/sdk/imx6ull/100ask_imx6ull-sdk/ToolChain/arm-buildroot-linux-gnueabihf_sdk-buildroot/bin/arm-buildroot-linux-gnueabihf-gcc

# 架构参数
ARCH_ARGS := CROSS_COMPILE=$(CROSS_COMPILE) ARCH=arm

# 当前目录
PWD := $(shell pwd)

# 编译选项
EXTRA_CFLAGS += -DDEBUG

# 默认目标：编译内核模块
all: modules

# 编译内核模块
modules:
	@echo "========================================="
	@echo "编译DS532驱动模块 (Stage 2)..."
	@echo "========================================="
	make $(ARCH_ARGS) -C $(KDIR) M=$(PWD) modules
	@echo ""
	@echo "编译完成！生成文件："
	@ls -lh ds532_driver_stage2.ko 2>/dev/null || echo "  ds532_driver_stage2.ko"
	@echo ""
	@echo "Stage 2 功能："
	@echo "  - Platform驱动框架"
	@echo "  - 字符设备接口"
	@echo "  - DS532协议封装函数"
	@echo "  - 数据包构造和验证"
	@echo ""

# 编译测试程序
test:
	@echo "编译Stage 2测试程序..."
	$(CC) user/stage2_protocol_test.c -o user/stage2_protocol_test
	@echo "测试程序编译完成！"
	@echo ""
	@echo "运行测试："
	@echo "  cd user && ./stage2_protocol_test"
	@echo ""

# 部署到开发板
install: modules
	@echo "========================================="
	@echo "部署DS532驱动到开发板 (Stage 2)..."
	@echo "========================================="
	adb push ds532_driver_stage2.ko /root/smart_lock/driver/
	@echo ""
	@echo "部署完成！"
	@echo ""
	@echo "在开发板上执行以下命令加载驱动："
	@echo "  insmod /root/smart_lock/driver/ds532_driver_stage2.ko"
	@echo ""
	@echo "验证设备节点："
	@echo "  ls -l /dev/ds532_fp"
	@echo ""
	@echo "查看内核日志："
	@echo "  dmesg | grep DS532"
	@echo ""
	@echo "测试协议封装："
	@echo "  1. 打开设备: cat /dev/ds532_fp"
	@echo "  2. 查看日志: dmesg | grep DS532 | tail -20"
	@echo ""

# 清理编译文件
clean:
	@echo "清理编译文件..."
	make $(ARCH_ARGS) -C $(KDIR) M=$(PWD) clean
	rm -f user/stage2_protocol_test
	@echo "清理完成！"

# 帮助信息
help:
	@echo "DS532驱动 Makefile - Stage 2版本"
	@echo "========================================="
	@echo "make          - 编译驱动模块"
	@echo "make modules  - 编译驱动模块"
	@echo "make test     - 编译测试程序"
	@echo "make install  - 部署到开发板"
	@echo "make clean    - 清理编译文件"
	@echo "make help     - 显示此帮助信息"
	@echo "========================================="
	@echo ""
	@echo "Stage 2 测试步骤："
	@echo "  1. 编译驱动：make"
	@echo "  2. 编译测试：make test"
	@echo "  3. 运行测试：cd user && ./stage2_protocol_test"
	@echo "  4. 部署驱动：make install"
	@echo "  5. 加载驱动：insmod ds532_driver_stage2.ko"
	@echo "  6. 验证功能：查看内核日志"
	@echo ""

.PHONY: all modules test install clean help
